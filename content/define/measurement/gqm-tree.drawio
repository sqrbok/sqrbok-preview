<mxfile host="drawio"><diagram name="fig" id="fig"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="g" value="&lt;b&gt;Goal&lt;/b&gt;: analyse the checkout code base to &lt;i&gt;improve&lt;/i&gt; its maintainability from the viewpoint of the developers, while new people join the team" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#2D6E2A;strokeColor=#019546;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontFamily=Tahoma;fontSize=15;" vertex="1" parent="1"><mxGeometry x="120" y="0" width="620" height="70" as="geometry"/></mxCell><mxCell id="q1" value="&lt;b&gt;Q1&lt;/b&gt; Which functions are hard to change?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#019546;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontFamily=Tahoma;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="330" height="56" as="geometry"/></mxCell><mxCell id="q2" value="&lt;b&gt;Q2&lt;/b&gt; How long does a typical fix take?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#019546;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontFamily=Tahoma;fontSize=15;" vertex="1" parent="1"><mxGeometry x="490" y="120" width="330" height="56" as="geometry"/></mxCell><mxCell id="m1" value="cyclomatic complexity per function" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#c8e6c9;strokeColor=#019546;strokeWidth=2;fontColor=#282828;fontFamily=Tahoma;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="230" width="190" height="56" as="geometry"/></mxCell><mxCell id="m2" value="functions changed in ≥ 3 fixes last quarter" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#c8e6c9;strokeColor=#019546;strokeWidth=2;fontColor=#282828;fontFamily=Tahoma;fontSize=14;" vertex="1" parent="1"><mxGeometry x="210" y="230" width="200" height="56" as="geometry"/></mxCell><mxCell id="m3" value="median hours from report to merged fix" style="rounded=1;whiteSpace=wrap