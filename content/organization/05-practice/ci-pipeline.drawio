<mxfile host="drawio"><diagram name="fig" id="fig"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="dev" value="Developer" style="fontFamily=Tahoma;whiteSpace=wrap;html=1;shape=umlActor;verticalLabelPosition=top;verticalAlign=bottom;fillColor=#f0f8f0;strokeColor=#2D6E2A;strokeWidth=2;fontSize=15;fontColor=#282828;" vertex="1" parent="1"><mxGeometry x="0" y="95" width="40" height="70" as="geometry"/></mxCell><mxCell id="push" value="&lt;b&gt;Push&lt;/b&gt;&lt;br&gt;small change to the&lt;br&gt;main line (or a pull request)" style="fontFamily=Tahoma;whiteSpace=wrap;html=1;shape=document;size=0.15;fillColor=#fff3cd;strokeColor=#c99700;strokeWidth=2;fontColor=#282828;fontSize=15;" vertex="1" parent="1"><mxGeometry x="80" y="80" width="190" height="90" as="geometry"/></mxCell><mxCell id="ci" value="CI server: runs on every push, in a clean machine" style="fontFamily=Tahoma;whiteSpace=wrap;html=1;rounded=1;arcSize=4;fillColor=none;strokeColor=#2D6E2A;strokeWidth=2;dashed=1;verticalAlign=top;fontStyle=1;fontColor=#2D6E2A;fontSize=16;" vertex="1" parent="1"><mxGeometry x="310" y="20" width="560" height="220" as="geometry"/></mxCell><mxCell id="s0" value="&lt;b&gt;1 Check out&lt;/b&gt;&lt;br&gt;the commit" style="fontFamily=Tahoma;whiteSpace=wrap;html=1;rounded=1;arcSize=12;fillColor=#f0f8f0;strokeColor=#019546;strokeWidth=2;fontColor=#282828;fontSize=15;" vertex="1" parent="1"><mxGeometry x="330" y="80" width="115" height="90" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;2 Install&lt;/b&gt;&lt;br&gt;Python and dependencies" style="fontFamily=Tahoma;whiteSpace=wrap;html=1;rounded=1;arcSize=12;fillColor=#f0f8f0;strokeColor=#019546;strokeWidth=2;fontColor=#282828;fontSize=15;" vertex="1" parent="1"><mxGeometry x="465" y="80" width="115" height="90" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;3 Lint&lt;/b&gt;&lt;br&gt;ruff check ." style="fontFamily=Tahoma;whiteSpace=wrap;html=1;rounded=1;arcSize=12;fillColor=#f