<mxfile host="drawio"><diagram name="fig" id="fig"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Evidence: people observe" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontColor=#282828;fontFamily=Tahoma;fontSize=17;fontStyle=1;fontColor=#2D6E2A;" vertex="1" parent="1"><mxGeometry x="170" y="0" width="280" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Evidence: calculation or measured data" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontColor=#282828;fontFamily=Tahoma;fontSize=17;fontStyle=1;fontColor=#2D6E2A;" vertex="1" parent="1"><mxGeometry x="470" y="0" width="280" height="36" as="geometry"/></mxCell><mxCell id="r1" value="Product&lt;br&gt;not run" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#2D6E2A;strokeColor=#019546;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontFamily=Tahoma;fontSize=17;" vertex="1" parent="1"><mxGeometry x="0" y="60" width="150" height="150" as="geometry"/></mxCell><mxCell id="r2" value="Product&lt;br&gt;run" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#019546;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontFamily=Tahoma;fontSize=17;" vertex="1" parent="1"><mxGeometry x="0" y="230" width="150" height="150" as="geometry"/></mxCell><mxCell id="ins" value="&lt;b&gt;Inspection&lt;/b&gt;&lt;br&gt;people examine the code, design or documents&lt;br&gt;&lt;i&gt;e.g. review of a pull request&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0f8f0;strokeColor=#019546;strokeWidth=2;fontColor=#282828;fontFamily=Tahoma;fontSize=16;" vertex="1" parent="1"><mxGeometry x="170" y="60" width="280" height="150" as="geometry"/></mxCell><mxCell id="ana" value="&lt;b&gt;Analysis&lt;/b&gt;&lt;br&gt;a tool or a person reasons about a model or the code&lt;br&gt;&lt;i&gt;e.g. mypy, a model checker&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0f8f0;strokeColor=#019546;strokeWidth=2;fontColor=#282828;fontFamily=Tahoma;fontSize=16;" vertex="1" parent="1"><mxGeometry x="470" y="60" width="280" height="150" as="geometry"/></mxCell><mxCell id="dem" value="&lt;b&gt;Demonstration&lt;/b&gt;&lt;br&gt;the product is used and the requirement is seen to be met, with no detailed data&lt;br&gt;&lt;i&gt;e.g. a user completes a checkout&lt;/i&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff3cd;strokeColor=#c99700;fontColor=#282828;align=left;spacingLeft=6;fontFamily=Tahoma;fontSize=16;" vertex="1" parent="1"><mxGeometry x="170" y="230" width="280" height="150" as="geometry"/></mxCell><mxCell id="tst" value="&lt;b&gt;Testing&lt;/b&gt;&lt;br&gt;the product runs under controlled conditions and each output is checked against an expected result&lt;br&gt;&lt;i&gt;e.g. a pytest suite&lt;/i&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff3cd;strokeColor=#c99700;fontColor=#282828;align=left;spacingLeft=6;fontFamily=Tahoma;fontSize=16;" vertex="1" parent="1"><mxGeometry x="470" y="230" width="280" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>