<mxfile host="drawio"><diagram name="fig" id="fig"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="l0" value="&lt;b&gt;1. Freestyle&lt;/b&gt;&lt;br&gt;only the test object" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#c8e6c9;strokeColor=#019546;strokeWidth=2;fontColor=#282828;fontFamily=Tahoma;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="40" width="145" height="90" as="geometry"/></mxCell><mxCell id="l1" value="&lt;b&gt;2. High exploration&lt;/b&gt;&lt;br&gt;charter with high-level goals" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#c8e6c9;strokeColor=#019546;strokeWidth=2;fontColor=#282828;fontFamily=Tahoma;fontSize=14;" vertex="1" parent="1"><mxGeometry x="160" y="40" width="145" height="90" as="geometry"/></mxCell><mxCell id="e1" value="" style="endArrow=block;endFill=1;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#2D6E2A;fontFamily=Tahoma;fontSize=14;html=1;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="l0" target="l1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l2" value="&lt;b&gt;3. Medium exploration&lt;/b&gt;&lt;br&gt;+ starting points and known risks" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0f8f0;strokeColor=#019546;strokeWidth=2;fontColor=#282828;fontFamily=Tahoma;fontSize=14;" vertex="1" parent="1"><mxGeometry x="320" y="40" width="145" height="90" as="geometry"/></mxCell><mxCell id="e2" value="" style="endArrow=block;endFill=1;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#2D6E2A;fontFamily=Tahoma;fontSize=14;html=1;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l3" value="&lt;b&gt;4. Low exploration&lt;/b&gt;&lt;br&gt;+ the activities to perform" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#019546;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontFamily=Tahoma;fontSize=14;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="480" y="40" width="145" height="90" as="geometry"/></mxCell><mxCell id="e3" value="" style="endArrow=block;endFill=1;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#2D6E2A;fontFamily=Tahoma;fontSize=14;html=1;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="l2" target="l3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l4" value="&lt;b&gt;5. Fully scripted&lt;/b&gt;&lt;br&gt;+ test steps and test data" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#2D6E2A;strokeColor=#019546;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontFamily=Tahoma;fontSize=14;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="640" y="40" width="145" height="90" as="geometry"/></mxCell><mxCell id="e4" value="" style="endArrow=block;endFill=1;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#2D6E2A;fontFamily=Tahoma;fontSize=14;html=1;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="l3" target="l4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cap" value="The tester receives:" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontColor=#282828;fontFamily=Tahoma;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="200" height="30" as="geometry"/></mxCell><mxCell id="left" value="&lt;b&gt;More exploration&lt;/b&gt;&lt;br&gt;finds new and unknown defects, adapts to change, motivates testers" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff3cd;strokeColor=#c99700;fontColor=#282828;align=left;spacingLeft=6;fontFamily=Tahoma;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="170" width="360" height="70" as="geometry"/></mxCell><mxCell id="right" value="&lt;b&gt;More scripting&lt;/b&gt;&lt;br&gt;traceable to requirements, defects easy to reproduce, suits novices" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff3cd;strokeColor=#c99700;fontColor=#282828;align=left;spacingLeft=6;fontFamily=Tahoma;fontSize=14;" vertex="1" parent="1"><mxGeometry x="425" y="170" width="360" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>