<mxfile host="drawio"><diagram name="fig" id="fig"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="i" value="&lt;b&gt;Inspection&lt;/b&gt;&lt;br&gt;trained roles,&lt;br&gt;entry/exit criteria" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#2D6E2A;strokeColor=#019546;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontFamily=Tahoma;fontSize=15;" vertex="1" parent="1"><mxGeometry x="10" y="60" width="145" height="100" as="geometry"/></mxCell><mxCell id="t" value="&lt;b&gt;Team review&lt;/b&gt;&lt;br&gt;planned,&lt;br&gt;less formal" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#019546;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontFamily=Tahoma;fontSize=15;" vertex="1" parent="1"><mxGeometry x="170" y="60" width="145" height="100" as="geometry"/></mxCell><mxCell id="w" value="&lt;b&gt;Walkthrough&lt;/b&gt;&lt;br&gt;author leads&lt;br&gt;the group" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#c8e6c9;strokeColor=#019546;strokeWidth=2;fontColor=#282828;fontFamily=Tahoma;fontSize=15;" vertex="1" parent="1"><mxGeometry x="330" y="60" width="145" height="100" as="geometry"/></mxCell><mxCell id="p" value="&lt;b&gt;Pair&lt;br&gt;programming&lt;/b&gt;&lt;br&gt;continuous&lt;br&gt;review" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#c8e6c9;strokeColor=#019546;strokeWidth=2;fontColor=#282828;fontFamily=Tahoma;fontSize=15;" vertex="1" parent="1"><mxGeometry x="490" y="60" width="145" height="100" as="geometry"/></mxCell><mxCell id="d" value="&lt;b&gt;Deskcheck,&lt;br&gt;passaround&lt;/b&gt;&lt;br&gt;one or several&lt;br&gt;reviewers alone" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0f8f0;strokeColor=#019546;strokeWidth=2;fontColor=#282828;fontFamily=Tahoma;fontSize=15;" vertex="1" parent="1"><mxGeometry x="650" y="60" width="145" height="100" as="geometry"/></mxCell><mxCell id="a" value="&lt;b&gt;Ad hoc review&lt;/b&gt;&lt;br&gt;spur of&lt;br&gt;the moment" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0f8f0;strokeColor=#019546;strokeWidth=2;fontColor=#282828;fontFamily=Tahoma;fontSize=15;" vertex="1" parent="1"><mxGeometry x="810" y="60" width="145" height="100" as="geometry"/></mxCell><mxCell id="hi" value="most formal" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontColor=#282828;fontFamily=Tahoma;fontSize=15;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="145" height="30" as="geometry"/></mxCell><mxCell id="lo" value="least formal" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontColor=#282828;fontFamily=Tahoma;fontSize=15;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="810" y="10" width="145" height="30" as="geometry"/></mxCell><mxCell id="n1" value="Planning, individual preparation, a logging meeting and verified rework: more defects found per line, more effort per review" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff3cd;strokeColor=#c99700;fontColor=#282828;align=left;spacingLeft=6;fontFamily=Tahoma;fontSize=14;" vertex="1" parent="1"><mxGeometry x="10" y="185" width="460" height="60" as="geometry"/></mxCell><mxCell id="n2" value="Little or no planning or preparation: cheap and fast, finds fewer defects, keeps few records" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff3cd;strokeColor=#c99700;fontColor=#282828;align=left;spacingLeft=6;fontFamily=Tahoma;fontSize=14;" vertex="1" parent="1"><mxGeometry x="495" y="185" width="460" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>