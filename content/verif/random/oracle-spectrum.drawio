<mxfile host="drawio"><diagram name="fig" id="fig"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="o0" value="&lt;b&gt;Crash / hang&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:13px&#x27;&gt;the program dies&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#c8e6c9;strokeColor=#019546;strokeWidth=2;fontColor=#282828;fontFamily=Tahoma;fontSize=15;" vertex="1" parent="1"><mxGeometry x="0" y="40" width="150" height="70" as="geometry"/></mxCell><mxCell id="o1" value="&lt;b&gt;Sanitizers&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:13px&#x27;&gt;memory and undefined-behaviour errors&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#c8e6c9;strokeColor=#019546;strokeWidth=2;fontColor=#282828;fontFamily=Tahoma;fontSize=15;" vertex="1" parent="1"><mxGeometry x="175" y="40" width="150" height="70" as="geometry"/></mxCell><mxCell id="e1" value="" style="endArrow=block;endFill=1;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#2D6E2A;fontFamily=Tahoma;fontSize=14;html=1;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="o0" target="o1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o2" value="&lt;b&gt;Contracts&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:13px&#x27;&gt;pre- and postconditions&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#019546;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontFamily=Tahoma;fontSize=15;" vertex="1" parent="1"><mxGeometry x="350" y="40" width="150" height="70" as="geometry"/></mxCell><mxCell id="e2" value="" style="endArrow=block;endFill=1;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#2D6E2A;fontFamily=Tahoma;fontSize=14;html=1;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="o1" target="o2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o3" value="&lt;b&gt;Properties&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:13px&#x27;&gt;rules for all inputs&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#019546;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontFamily=Tahoma;fontSize=15;" vertex="1" parent="1"><mxGeometry x="525" y="40" width="150" height="70" as="geometry"/></mxCell><mxCell id="e3" value="" style="endArrow=block;endFill=1;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#2D6E2A;fontFamily=Tahoma;fontSize=14;html=1;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="o2" target="o3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o4" value="&lt;b&gt;Differential&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:13px&#x27;&gt;another implementation&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#2D6E2A;strokeColor=#019546;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontFamily=Tahoma;fontSize=15;" vertex="1" parent="1"><mxGeometry x="700" y="40" width="150" height="70" as="geometry"/></mxCell><mxCell id="e4" value="" style="endArrow=block;endFill=1;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#2D6E2A;fontFamily=Tahoma;fontSize=14;html=1;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="o3" target="o4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l" value="more automatic, finds only crashes" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontColor=#282828;fontFamily=Tahoma;fontSize=14;align=left;fontColor=#2D6E2A;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="330" height="30" as="geometry"/></mxCell><mxCell id="r" value="more human effort, finds wrong answers" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontColor=#282828;fontFamily=Tahoma;fontSize=14;align=right;fontColor=#2D6E2A;fontStyle=2;" vertex="1" parent="1"><mxGeome