<mxfile host="drawio"><diagram name="fig" id="fig"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="g" value="Generator&lt;br&gt;&lt;span style=&#x27;font-size:12px&#x27;&gt;random value of the input type&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#c8e6c9;strokeColor=#019546;strokeWidth=2;fontColor=#282828;fontFamily=Tahoma;fontSize=15;" vertex="1" parent="1"><mxGeometry x="0" y="40" width="180" height="70" as="geometry"/></mxCell><mxCell id="p" value="Check the property&lt;br&gt;&lt;span style=&#x27;font-size:12px&#x27;&gt;e.g. decode(encode(s)) == s&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#019546;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontFamily=Tahoma;fontSize=15;" vertex="1" parent="1"><mxGeometry x="230" y="40" width="200" height="70" as="geometry"/></mxCell><mxCell id="ok" value="holds: next input&lt;br&gt;&lt;span style=&#x27;font-size:12px&#x27;&gt;(100 by default)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0f8f0;strokeColor=#019546;strokeWidth=2;fontColor=#282828;fontFamily=Tahoma;fontSize=14;" vertex="1" parent="1"><mxGeometry x="480" y="0" width="180" height="56" as="geometry"/></mxCell><mxCell id="ce" value="fails: counterexample" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fde8e6;strokeColor=#b42318;strokeWidth=2;fontColor=#b42318;fontStyle=1;fontFamily=Tahoma;fontSize=14;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="480" y="90" width="180" height="50" as="geometry"/></mxCell><mxCell id="sh" value="Shrink to the smallest input that still fails" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#2D6E2A;strokeColor=#019546;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontFamily=Tahoma;fontSize=14;" vertex="1" parent="1"><mxGeometry x="710" y="85" width="210" height="60" as="geometry"/></mxCell><mxCell id="e1" value="" style="endArrow=block;endFill=1;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#2D6E2A;fontFamily=Tahoma;fontSize=14;html=1;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="g" target="p"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="endArrow=block;endFill=1;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#2D6E2A;fontFamily=Tahoma;fontSize=14;html=1;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="p" target="ok"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="endArrow=block;endFill=1;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#2D6E2A;fontFamily=Tahoma;fontSize=14;html=1;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.75;entryX=0;entryY=0.5;" edge="1" parent="1" source="p" target="ce"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="endArrow=block;endFill=1;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#2D6E2A;fontFamily=Tahoma;fontSize=14;html=1;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="ce" target="sh"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="endArrow=block;endFill=1;strokeColor=#c99700;strokeWidth=2;dashed=1;fontColor=#8a6d00;fontFamily=Tahoma;fontSize=14;html=1;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="ok" target="g"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="570" y="-25"/><mxPoint x="90" y="-25"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>