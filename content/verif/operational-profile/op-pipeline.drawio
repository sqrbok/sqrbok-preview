<mxfile host="drawio"><diagram name="fig" id="fig"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="u" value="&lt;b&gt;Usage data&lt;/b&gt;&lt;br&gt;logs, telemetry, surveys, expert estimates" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.15;fillColor=#f0f8f0;strokeColor=#019546;strokeWidth=2;fontColor=#282828;fontFamily=Tahoma;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="40" width="170" height="90" as="geometry"/></mxCell><mxCell id="p" value="&lt;b&gt;Operational profile&lt;/b&gt;&lt;br&gt;browse 6,000/h → 0.60&lt;br&gt;search 2,400/h → 0.24&lt;br&gt;add to cart 1,200/h → 0.12&lt;br&gt;checkout 300/h → 0.03&lt;br&gt;admin report 100/h → 0.01&lt;br&gt;&lt;i&gt;total 10,000/h&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0f8f0;strokeColor=#019546;strokeWidth=2;fontColor=#282828;fontFamily=Tahoma;fontSize=14;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="300" y="0" width="240" height="160" as="geometry"/></mxCell><mxCell id="t" value="&lt;b&gt;1,000 tests&lt;/b&gt;&lt;br&gt;600 browse&lt;br&gt;240 search&lt;br&gt;120 add to cart&lt;br&gt;30 checkout&lt;br&gt;10 admin report" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#019546;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontFamily=Tahoma;fontSize=14;fontStyle=0;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="620" y="20" width="170" height="130" as="geometry"/></mxCell><mxCell id="r" value="&lt;b&gt;Share of failing runs&lt;/b&gt;&lt;br&gt;× field runs per hour = expected failures per hour" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#2D6E2A;strokeColor=#019546;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontFamily=Tahoma;fontSize=14;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="870" y="40" width="180" height="90" as="geometry"/></mxCell><mxCell id="e1" value="rates ÷ total" style="endArrow=block;endFill=1;strokeColor=#2D6E2A