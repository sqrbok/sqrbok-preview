<mxfile host="drawio"><diagram name="fig" id="fig"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="r" value="&lt;b&gt;Reach&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:13px&#x27;&gt;the test executes the faulty code&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#c8e6c9;strokeColor=#019546;strokeWidth=2;fontColor=#282828;fontFamily=Tahoma;fontSize=16;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="170" height="80" as="geometry"/></mxCell><mxCell id="i" value="&lt;b&gt;Infect&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:13px&#x27;&gt;the program state goes wrong&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#019546;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontFamily=Tahoma;fontSize=16;" vertex="1" parent="1"><mxGeometry x="210" y="0" width="170" height="80" as="geometry"/></mxCell><mxCell id="p" value="&lt;b&gt;Propagate&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:13px&#x27;&gt;the wrong state reaches an output&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#019546;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontFamily=Tahoma;fontSize=16;" vertex="1" parent="1"><mxGeometry x="420" y="0" width="170" height="80" as="geometry"/></mxCell><mxCell id="o" value="&lt;b&gt;Reveal&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:13px&#x27;&gt;an assertion checks that output&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#2D6E2A;strokeColor=#019546;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontFamily=Tahoma;fontSize=16;" vertex="1" parent="1"><mxGeometry x="630" y="0" width="170" height="80" as="geometry"/></mxCell><mxCell id="e1" value="" style="endArrow=block;endFill=1;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#2D6E2A;fontFamily=Tahoma;fontSize=14;html=1;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="r" target="i"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="endArrow=block;endFill=1;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#2D6E2A;fontFamily=Tahoma;fontSize=14;html=1;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="i" target="p"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="endArrow=block;endFill=1;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#2D6E2A;fontFamily=Tahoma;fontSize=14;html=1;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="p" target="o"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cov" value="Coverage measures only this step" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff3cd;strokeColor=#c99700;fontColor=#282828;align=left;spacingLeft=6;fontFamily=Tahoma;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="0" y="110" width="170" height="50" as="geometry"/></mxCell><mxCell id="cc" value="&lt;b&gt;Coincidental correctness&lt;/b&gt;: reached (and maybe infected), yet the output is correct, so the test passes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fde8e6;strokeColor=#b42318;strokeWidth=2;fontColor=#b42318;fontStyle=1;fontFamily=Tahoma;fontSize=13;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="210" y="110" width="380" height="60" as="geometry"/></mxCell><mxCell id="w" value="&lt;b&gt;Weak oracle&lt;/b&gt;: wrong output, but nothing checks it" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fde8e6;strokeColor=#b42318;strokeWidth=2;fontColor=#b42318;fontStyle=1;fontFamily=Tahoma;fontSize=13;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="630" y="110" width="170" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>