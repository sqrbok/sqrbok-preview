<mxfile host="drawio"><diagram name="fig" id="fig"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="fault" value="&lt;b&gt;Fault&lt;/b&gt;&lt;br&gt;query built by string&lt;br&gt;concatenation" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0f8f0;strokeColor=#019546;strokeWidth=2;fontColor=#282828;fontFamily=Tahoma;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="190" height="80" as="geometry"/></mxCell><mxCell id="atk" value="&lt;b&gt;Attack&lt;/b&gt;&lt;br&gt;name = alice&#x27; --" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fde8e6;strokeColor=#b42318;strokeWidth=2;fontColor=#b42318;fontStyle=1;fontFamily=Tahoma;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="190" height="60" as="geometry"/></mxCell><mxCell id="err" value="&lt;b&gt;Error&lt;/b&gt;&lt;br&gt;query ignores the&lt;br&gt;password check" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#c8e6c9;strokeColor=#019546;strokeWidth=2;fontColor=#282828;fontFamily=Tahoma;fontSize=16;" vertex="1" parent="1"><mxGeometry x="270" y="120" width="190" height="80" as="geometry"/></mxCell><mxCell id="fail" value="&lt;b&gt;Failure&lt;/b&gt;&lt;br&gt;attacker acts as Alice:&lt;br&gt;reads and changes her data" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#2D6E2A;strokeColor=#019546;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontFamily=Tahoma;fontSize=16;" vertex="1" parent="1"><mxGeometry x="520" y="120" width="210" height="80" as="geometry"/></mxCell><mxCell id="bug" value="&lt;b&gt;Ordinary input&lt;/b&gt;&lt;br&gt;name = O&#x27;Brien" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff3cd;strokeColor=#c99700;fontColor=#282828;align=left;spacingLeft=6;fontFamily=Tahoma;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="190" height="60" as="geometry"/></mxCell><mxCell id="crash" value="&lt;b&gt;Error&lt;/b&gt;&lt;br&gt;malformed query" style="s