<mxfile host="drawio"><diagram name="fig" id="fig"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s0" value="&lt;b&gt;1. Measure&lt;/b&gt;&lt;br&gt;counters T, A, C, B&lt;br&gt;per resource" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0f8f0;strokeColor=#019546;strokeWidth=2;fontColor=#282828;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="155" height="90" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;2. Derive&lt;/b&gt;&lt;br&gt;X, U, S, R and&lt;br&gt;service demands D" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0f8f0;strokeColor=#019546;strokeWidth=2;fontColor=#282828;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="170" y="0" width="155" height="90" as="geometry"/></mxCell><mxCell id="e1" value="" style="endArrow=block;endFill=1;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#2D6E2A;fontFamily=Tahoma;fontSize=14;html=1;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s2" value="&lt;b&gt;3. Model&lt;/b&gt;&lt;br&gt;operational laws,&lt;br&gt;queuing model, MVA" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#019546;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontFamily=Tahoma;fontSize=13;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="340" y="0" width="155" height="90" as="geometry"/></mxCell><mxCell id="e2" value="" style="endArrow=block;endFill=1;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#2D6E2A;fontFamily=Tahoma;fontSize=14;html=1;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s3" value="&lt;b&gt;4. Predict&lt;/b&gt;&lt;br&gt;what if load doubles?&lt;br&gt;what if the DB is faster?" style="rounded=1;wh