ck;endFill=1;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#2D6E2A;fontFamily=Tahoma;fontSize=14;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="root" target="l1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l2" value="leaf 3: &lt;b&gt;1,000 ms&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fde8e6;strokeColor=#b42318;strokeWidth=2;fontColor=#b42318;fontStyle=1;fontFamily=Tahoma;fontSize=14;" vertex="1" parent="1"><mxGeometry x="430" y="120" width="160" height="44" as="geometry"/></mxCell><mxCell id="e4" value="" style="endArrow=block;endFill=1;strokeColor=#b42318;strokeWidth=4;fontColor=#b42318;fontStyle=1;fontFamily=Tahoma;fontSize=14;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="root" target="l2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l3" value="leaf 4: 11 ms" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0f8f0;strokeColor=#019546;strokeWidth=2;fontColor=#282828;fontFamily=Tahoma;fontSize=14;" vertex="1" parent="1"><mxGeometry x="430" y="180" width="160" height="44" as="geometry"/></mxCell><mxCell id="e5" value="" style="endArrow=block;endFill=1;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#2D6E2A;fontFamily=Tahoma;fontSize=14;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="root" target="l3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l4" value="… leaf 100" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0f8f0;strokeColor=#019546;strokeWidth=2;fontColor=#282828;fontFamily=Tahoma;fontSize=14;" vertex="1" parent="1"><mxGeometry x="430" y="240" width="160" height="44" as="geometry"/></mxCell><mxCell id="e6" value="" style="endArrow=block;endFill=1;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#2D6E2A;fontFamily=Tahoma;fontSize=14;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="root" target="l4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="nt" value="The reply is as slow as the &lt;b&gt;slowest&lt;/b&gt; leaf.&lt;br&gt;If each leaf is slow on 1% of requests (p = 0.01) and there are N = 100 leaves,&lt;br&gt;P(the user waits for a slow leaf) = 1 − (1 − p)&lt;sup&gt;N&lt;/sup&gt; = 1 − 0.99&lt;sup&gt;100&lt;/sup&gt; ≈ 63%" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff3cd;strokeColor=#c99700;fontColor=#282828;align=left;spacingLeft=6;fontFamily=Tahoma;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="300" width="590" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>