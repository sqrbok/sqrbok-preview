<mxfile host="drawio"><diagram name="fig" id="fig"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b" value="&lt;b&gt;Baseline&lt;/b&gt;&lt;br&gt;1 user, best case:&lt;br&gt;the yardstick" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0f8f0;strokeColor=#019546;strokeWidth=2;fontColor=#282828;fontFamily=Tahoma;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="170" height="80" as="geometry"/></mxCell><mxCell id="l" value="&lt;b&gt;Load&lt;/b&gt;&lt;br&gt;expected peak:&lt;br&gt;does it meet the target?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#019546;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontFamily=Tahoma;fontSize=14;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="290" y="90" width="190" height="80" as="geometry"/></mxCell><mxCell id="st" value="&lt;b&gt;Stress&lt;/b&gt;&lt;br&gt;past the expected peak:&lt;br&gt;where does it break?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fde8e6;strokeColor=#b42318;strokeWidth=2;fontColor=#b42318;fontStyle=1;fontFamily=Tahoma;fontSize=14;" vertex="1" parent="1"><mxGeometry x="650" y="0" width="190" height="70" as="geometry"/></mxCell><mxCell id="so" value="&lt;b&gt;Soak&lt;/b&gt;&lt;br&gt;expected load for hours:&lt;br&gt;leaks, slow drift" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#c8e6c9;strokeColor=#019546;strokeWidth=2;fontColor=#282828;fontFamily=Tahoma;fontSize=14;" vertex="1" parent="1"><mxGeometry x="650" y="95" width="190" height="70" as="geometry"/></mxCell><mxCell id="i" value="&lt;b&gt;Isolation&lt;/b&gt;&lt;br&gt;one transaction, repeated:&lt;br&gt;diagnose a known issue" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0f8f0;strokeColor=#019546;strokeWidth=2;fontColor=#282828;fontFamily=Tahoma;fontSize=14;" vertex="1" parent="1"><mxGeometry x="650" y="190" width="190" height="70" as="geometry"/></mxCell><mxCell id="sm" value="&lt;b&gt;Smoke&lt;/b&gt;&lt;br&gt;changed code only:&lt;br&gt;quick gate per build" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff3cd;strokeColor=#c99700;fontColor=#282828;align=left;spacingLeft=6;fontFamily=Tahoma;fontSize=14;" vertex="1" parent="1"><mxGeometry x="290" y="230" width="190" height="70" as="geometry"/></mxCell><mxCell id="e1" value="compare against" style="endArrow=block;endFill=1;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#2D6E2A;fontFamily=Tahoma;fontSize=13;html=1;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="b" target="l"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="push past peak" style="endArrow=block;endFill=1;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#2D6E2A;fontFamily=Tahoma;fontSize=13;html=1;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="l" target="st"><mxGeometry x="0.2" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="hold for hours" style="endArrow=block;endFill=1;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#2D6E2A;fontFamily=Tahoma;fontSize=13;html=1;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="l" target="so"><mxGeometry x="0.2" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="drill into a slow step" style="endArrow=block;endFill=1;strokeColor=#2D6E2A;strokeWidth=2;fontColor=#2D6E2A;fontFamily=Tahoma;fontSize=13;html=1;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="l" target="i"><mxGeometry x="0.2" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="passes, then" style="endArrow=block;endFill=1;strokeColor=#c99700;strokeWidth=2;dashed=1;fontColor=#8a6d00;fontFamily=Tahoma;fontSize=13;html=1;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="sm" target="l"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>